{
  "name": "@lightweaver/study-films",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "npm run weaver -w @lightweaver/weaver -- sync",
    "studio": "npm run sync && remotion studio src/index.ts",
    "capture": "node scripts/capture.mjs",
    "tts": "npm run weaver -w @lightweaver/weaver -- tts",
    "render": "npm run weaver -w @lightweaver/weaver -- render",
    "films": "node scripts/capture.mjs && npm run weaver -w @lightweaver/weaver -- tts && npm run weaver -w @lightweaver/weaver -- render",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/subtitles.test.ts"
  },
  "dependencies": {
    "@lightweaver/weaver": "*",
    "@remotion/cli": "4.0.512",
    "@remotion/media": "4.0.512",
    "@remotion/media-utils": "4.0.512",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.12",
    "playwright": "^1.55.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
