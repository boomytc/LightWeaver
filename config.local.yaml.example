# Copy to config.local.yaml (gitignored). Do not commit real keys or machine paths.
modelbest_base_url: 'https://api.modelbest.cn/v1'
modelbest_api_key: ''

# Optional ASR. Default is Qwen3-ASR-0.6B GGUF + sibling ../LightASR.
# Point these at this machine. 1.7B: change asr_model to Qwen3-ASR-1.7B-Q8_0.gguf.
# asr_model: '/absolute/path/to/qwen3-asr-0.6b-Q8_0.gguf'
# asr_library: '/absolute/path/to/libtranscribe.dylib'
# asr_bindings: '/absolute/path/to/transcribe.cpp/bindings/python/src'

# Optional VLM for weaver describe. Default MiniCPM-V-4.6 on ModelBest (same key as TTS).
# vlm_model: MiniCPM-V-4.6
